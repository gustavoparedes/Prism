<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Prism</AssemblyName>
    <RootNamespace>Prism.Wpf</RootNamespace>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\prism.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\prism.ico" />
    <Resource Include="Assets\prism.png" />
    <EmbeddedResource Include="..\syncfusion-license.txt" Condition="Exists('..\syncfusion-license.txt')" LogicalName="Prism.RuntimeLicense" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prism.Core\Prism.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Syncfusion.SfGrid.WPF" Version="31.1.17" />
  </ItemGroup>

</Project>
